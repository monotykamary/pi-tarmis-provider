{
  "name": "pi-tarmis-provider",
  "version": "1.1.11",
  "description": "Tarmis provider extension for pi - Open models on Tarmis's own GPUs via an OpenAI-compatible API",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "clean": "echo 'nothing to clean'",
    "build": "echo 'nothing to build'",
    "check": "tsc -p tsconfig.check.json && node scripts/test-pi-compat.mjs",
    "update-models": "node scripts/update-models.js",
    "test:pi": "node scripts/test-pi-compat.mjs",
    "typecheck": "tsc -p tsconfig.check.json"
  },
  "keywords": [
    "pi",
    "extension",
    "provider",
    "tarmis",
    "ai",
    "llm",
    "openai-compatible",
    "deepseek",
    "glm",
    "kimi",
    "minimax"
  ],
  "author": "monotykamary",
  "license": "MIT",
  "homepage": "https://github.com/monotykamary/pi-tarmis-provider#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monotykamary/pi-tarmis-provider.git"
  },
  "bugs": {
    "url": "https://github.com/monotykamary/pi-tarmis-provider/issues"
  },
  "files": [
    "index.ts",
    "models.json",
    "deprecated-models.json",
    "custom-models.json",
    "patch.json",
    "scripts/update-models.js",
    "README.md",
    "LICENSE",
    "AGENTS.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "overrides": {
    "brace-expansion": "5.0.12"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  }
}
